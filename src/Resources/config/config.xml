<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/platform/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>beliq connection</title>
        <title lang="de-DE">beliq-Verbindung</title>
        <input-field type="password">
            <name>apiKey</name>
            <label>API key</label>
            <label lang="de-DE">API-Schlüssel</label>
            <helpText>Your beliq API key. The free tier is enough to evaluate the plugin.</helpText>
            <helpText lang="de-DE">Ihr beliq-API-Schlüssel. Der kostenlose Tarif reicht, um das Plugin zu testen.</helpText>
        </input-field>
    </card>

    <card>
        <title>Seller details</title>
        <title lang="de-DE">Verkäuferangaben</title>
        <input-field type="text">
            <name>sellerName</name>
            <label>Legal name</label>
            <label lang="de-DE">Firmenname</label>
        </input-field>
        <input-field type="text">
            <name>sellerVatId</name>
            <label>VAT ID</label>
            <label lang="de-DE">USt-IdNr.</label>
        </input-field>
        <input-field type="text">
            <name>sellerTaxId</name>
            <label>Tax number</label>
            <label lang="de-DE">Steuernummer</label>
        </input-field>
        <input-field type="text">
            <name>sellerRegistrationId</name>
            <label>Company registration number</label>
            <label lang="de-DE">Handelsregisternummer</label>
        </input-field>
        <input-field type="text">
            <name>sellerEmail</name>
            <label>Contact e-mail</label>
            <label lang="de-DE">Kontakt-E-Mail</label>
            <helpText>The seller contact e-mail (BT-43), which XRechnung requires (BR-DE-7). For XRechnung, ZUGFeRD and Factur-X it is also the seller electronic address (BT-34).</helpText>
            <helpText lang="de-DE">Die E-Mail-Adresse des Ansprechpartners beim Verkäufer (BT-43), die für XRechnung erforderlich ist (BR-DE-7). Bei XRechnung, ZUGFeRD und Factur-X handelt es sich dabei auch um die elektronische Adresse des Verkäufers (BT-34).</helpText>
        </input-field>
        <input-field type="text">
            <name>sellerContactName</name>
            <label>Contact person</label>
            <label lang="de-DE">Ansprechpartner</label>
            <helpText>Seller contact name (BG-6 / BT-41). Required by XRechnung (BR-DE-5).</helpText>
            <helpText lang="de-DE">Name des Ansprechpartners beim Verkäufer (BG-6 / BT-41). Erforderlich gemäß XRechnung (BR-DE-5).</helpText>
        </input-field>
        <input-field type="text">
            <name>sellerPhone</name>
            <label>Contact phone</label>
            <label lang="de-DE">Telefon</label>
            <helpText>Seller contact telephone (BT-42). Required by XRechnung (BR-DE-6).</helpText>
            <helpText lang="de-DE">Telefonnummer des Ansprechpartners beim Verkäufer (BT-42). Erforderlich gemäß XRechnung (BR-DE-6).</helpText>
        </input-field>
        <input-field type="text">
            <name>sellerStreet</name>
            <label>Street and number</label>
            <label lang="de-DE">Straße und Hausnummer</label>
        </input-field>
        <input-field type="text">
            <name>sellerPostalCode</name>
            <label>Postal code</label>
            <label lang="de-DE">Postleitzahl</label>
        </input-field>
        <input-field type="text">
            <name>sellerCity</name>
            <label>City</label>
            <label lang="de-DE">Ort</label>
        </input-field>
        <input-field type="text">
            <name>sellerCountryCode</name>
            <label>Country code (2 letters)</label>
            <label lang="de-DE">Ländercode (2 Buchstaben)</label>
            <placeholder>DE</placeholder>
        </input-field>
    </card>

    <card>
        <title>Payment details</title>
        <title lang="de-DE">Zahlungsangaben</title>
        <input-field type="single-select">
            <name>paymentMeansCode</name>
            <label>Payment means</label>
            <label lang="de-DE">Zahlungsart</label>
            <helpText>How the buyer pays (BG-16). Both options are credit transfers (codes 58 and 30), for which XRechnung requires the credit transfer details (BG-17, BR-DE-23-a). The plugin sends the payment details only together with an IBAN.</helpText>
            <helpText lang="de-DE">Zahlungsart des Käufers (BG-16). Bei beiden Optionen handelt es sich um Überweisungen (Codes 58 und 30), für die XRechnung die Überweisungsdaten benötigt (BG-17, BR-DE-23-a). Das Plugin übermittelt die Zahlungsdaten nur zusammen mit einer IBAN.</helpText>
            <defaultValue>58</defaultValue>
            <options>
                <option>
                    <id>58</id>
                    <name>SEPA credit transfer</name>
                    <name lang="de-DE">SEPA-Überweisung</name>
                </option>
                <option>
                    <id>30</id>
                    <name>Credit transfer</name>
                    <name lang="de-DE">Überweisung</name>
                </option>
            </options>
        </input-field>
        <input-field type="text">
            <name>sellerIban</name>
            <label>IBAN</label>
            <label lang="de-DE">IBAN</label>
            <helpText>The account the buyer pays into. Without an IBAN the invoice carries no payment instructions (BG-16), which XRechnung requires (BR-DE-1). Leave it empty only if you generate no XRechnung.</helpText>
            <helpText lang="de-DE">Das Konto, auf das der Käufer überweist. Ohne IBAN enthält die Rechnung keine Zahlungsanweisungen (BG-16), die für XRechnung vorgeschrieben sind (BR-DE-1). Lassen Sie das Feld nur leer, wenn Sie keine XRechnung erstellen.</helpText>
        </input-field>
        <input-field type="text">
            <name>sellerBic</name>
            <label>BIC</label>
            <label lang="de-DE">BIC</label>
        </input-field>
        <input-field type="text">
            <name>sellerBankName</name>
            <label>Bank name</label>
            <label lang="de-DE">Name der Bank</label>
        </input-field>
    </card>

    <card>
        <title>Invoice generation</title>
        <title lang="de-DE">Rechnungserzeugung</title>
        <input-field type="bool">
            <name>enabled</name>
            <label>Generate invoices automatically</label>
            <label lang="de-DE">Rechnungen automatisch erzeugen</label>
            <defaultValue>false</defaultValue>
        </input-field>
        <input-field type="single-select">
            <name>standard</name>
            <label>Document format</label>
            <label lang="de-DE">Dokumentformat</label>
            <defaultValue>zugferd</defaultValue>
            <options>
                <option>
                    <id>zugferd</id>
                    <name>ZUGFeRD / Factur-X (hybrid PDF)</name>
                </option>
                <option>
                    <id>facturx</id>
                    <name>Factur-X (hybrid PDF)</name>
                </option>
                <option>
                    <id>xrechnung</id>
                    <name>XRechnung (XML)</name>
                </option>
                <option>
                    <id>peppol-bis</id>
                    <name>Peppol BIS Billing (XML)</name>
                </option>
            </options>
        </input-field>
        <input-field type="single-select">
            <name>profile</name>
            <label>Profile</label>
            <label lang="de-DE">Profil</label>
            <defaultValue>en16931</defaultValue>
            <options>
                <option>
                    <id>en16931</id>
                    <name>EN 16931 (comfort)</name>
                </option>
                <option>
                    <id>basicwl</id>
                    <name>Basic WL</name>
                </option>
                <option>
                    <id>extended</id>
                    <name>Extended</name>
                </option>
            </options>
        </input-field>
        <input-field type="single-select">
            <name>output</name>
            <label>Output</label>
            <label lang="de-DE">Ausgabeformat</label>
            <defaultValue>pdf</defaultValue>
            <options>
                <option>
                    <id>pdf</id>
                    <name>PDF (hybrid, where the format supports it)</name>
                    <name lang="de-DE">PDF (hybrid, wenn das Dokumentformat es unterstützt)</name>
                </option>
                <option>
                    <id>xml</id>
                    <name>XML only</name>
                    <name lang="de-DE">Nur XML</name>
                </option>
            </options>
        </input-field>
        <input-field type="bool">
            <name>businessOnly</name>
            <label>Only for business orders</label>
            <label lang="de-DE">Nur für Geschäftskunden</label>
            <helpText>Generate only when the buyer looks like a business (VAT ID, company, or business account). Turn off to generate for every order.</helpText>
            <helpText lang="de-DE">Nur erzeugen, wenn der Käufer als Unternehmen erkennbar ist (USt-IdNr., Firma oder Geschäftskundenkonto). Deaktivieren Sie diese Option, um für jede Bestellung eine E-Rechnung zu erstellen.</helpText>
            <defaultValue>true</defaultValue>
        </input-field>
        <input-field type="single-select">
            <name>triggerEvent</name>
            <label>Generate when</label>
            <label lang="de-DE">Erzeugen bei</label>
            <defaultValue>state_enter.order_transaction.state.paid</defaultValue>
            <options>
                <option>
                    <id>state_enter.order_transaction.state.paid</id>
                    <name>Payment is marked paid</name>
                    <name lang="de-DE">Zahlung ist als bezahlt markiert</name>
                </option>
                <option>
                    <id>state_enter.order.state.completed</id>
                    <name>Order is completed</name>
                    <name lang="de-DE">Bestellung ist abgeschlossen</name>
                </option>
            </options>
        </input-field>
        <input-field type="single-select">
            <name>zeroRateCategory</name>
            <label>VAT category for 0% lines</label>
            <label lang="de-DE">USt-Kategorie für 0%-Positionen</label>
            <helpText>The tax treatment for zero-rated lines is the merchant's call. Reverse charge and intra-community supply are not auto-detected.</helpText>
            <helpText lang="de-DE">Die steuerliche Handhabung von 0%-Positionen liegt in der Verantwortung des Händlers. Reverse-Charge-Verfahren und innergemeinschaftliche Lieferungen werden nicht automatisch erkannt.</helpText>
            <defaultValue>Z</defaultValue>
            <options>
                <option>
                    <id>Z</id>
                    <name>Z - Zero rated</name>
                </option>
                <option>
                    <id>E</id>
                    <name>E - Exempt</name>
                </option>
                <option>
                    <id>G</id>
                    <name>G - Export outside the EU</name>
                </option>
            </options>
        </input-field>
    </card>
</config>
