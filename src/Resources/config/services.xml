<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="Beliq\Shopware\Service\InvoiceMapper"/>

        <service id="Beliq\Shopware\Service\OrderAdapter"/>

        <service id="Beliq\Shopware\Service\AttemptHttpClient"/>

        <service id="Beliq\Shopware\Service\HttpClient" alias="Beliq\Shopware\Service\AttemptHttpClient"/>

        <service id="Beliq\Shopware\Config\PluginConfigProvider">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="Beliq\Shopware\Document\InvoiceDocumentLookup">
            <argument type="service" id="document.repository"/>
        </service>

        <service id="Beliq\Shopware\Document\BeliqInvoiceRenderer">
            <argument type="service" id="order.repository"/>
            <argument type="service" id="Beliq\Shopware\Config\PluginConfigProvider"/>
            <argument type="service" id="Beliq\Shopware\Service\OrderAdapter"/>
            <argument type="service" id="Beliq\Shopware\Service\InvoiceMapper"/>
            <argument type="service" id="Beliq\Shopware\Document\InvoiceDocumentLookup"/>
            <argument type="service" id="Beliq\Shopware\Retry\OrderCustomFieldRecorder"/>
            <argument type="service" id="Beliq\Shopware\Service\HttpClient"/>
            <tag name="document.renderer"/>
        </service>

        <service id="Beliq\Shopware\Retry\RetryStore">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="Beliq\Shopware\Retry\DocumentInvoiceGeneration">
            <argument type="service" id="Beliq\Shopware\Config\PluginConfigProvider"/>
            <argument type="service" id="Shopware\Core\Checkout\Document\Service\DocumentGenerator"/>
            <argument type="service" id="Beliq\Shopware\Document\InvoiceDocumentLookup"/>
            <argument type="service" id="Beliq\Shopware\Service\AttemptHttpClient"/>
        </service>

        <service id="Beliq\Shopware\Retry\OrderCustomFieldRecorder">
            <argument type="service" id="order.repository"/>
        </service>

        <service id="Beliq\Shopware\Retry\InvoiceAttempts">
            <argument type="service" id="Beliq\Shopware\Retry\RetryStore"/>
            <argument type="service" id="Beliq\Shopware\Retry\DocumentInvoiceGeneration"/>
            <argument type="service" id="Beliq\Shopware\Retry\OrderCustomFieldRecorder"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Psr\Clock\ClockInterface"/>
        </service>

        <service id="Beliq\Shopware\Retry\InvoiceRetryTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="Beliq\Shopware\Retry\InvoiceRetryTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Beliq\Shopware\Retry\InvoiceAttempts"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="Beliq\Shopware\Subscriber\OrderStateSubscriber">
            <argument type="service" id="Beliq\Shopware\Config\PluginConfigProvider"/>
            <argument type="service" id="Beliq\Shopware\Document\InvoiceDocumentLookup"/>
            <argument type="service" id="Beliq\Shopware\Retry\InvoiceAttempts"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>
    </services>
</container>
